{
  "editor.fontSize": 20,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.donotVerifyTags": true,
  "files.autoSave": "afterDelay",
  "security.workspace.trust.untrustedFiles": "open",
  "code-runner.runInTerminal": true,
  "[java]": {
    "editor.suggest.snippetsPreventQuickSuggestions": false
  },
  "workbench.colorTheme": "Vira Carbon High Contrast",
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "window.zoomLevel": -1,
  "editor.accessibilitySupport": "on",
  "accessibility.signals.diffLineInserted": {
    "sound": "off"
  },
  "accessibility.signals.chatRequestSent": {
    "announcement": "off",
    "sound": "off"
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off"
  },
  "accessibility.signals.clear": {
    "sound": "off",
    "announcement": "off"
  },
  "workbench.iconTheme": "material-icon-theme",
  "liveServer.settings.fullReload": true,
  "editor.minimap.enabled": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.env.windows": {},
  "php.validate.executablePath": "C:/xampp/php/php.exe",
  "editor.formatOnSave": true,
  "accessibility.signals.chatUserActionRequired": {
    "sound": "off"
  },
  "accessibility.signalOptions.volume": 0,
  "accessibility.signals.progress": {
    "sound": "on"
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off"
  },
  "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
  "workbench.editor.empty.hint": "hidden",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.initialHint": false,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on"
  },
  "editor.guides.bracketPairs": "active",
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#72a6f8",
    "activityBar.background": "#72a6f8",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#fde1ec",
    "activityBarBadge.foreground": "#15202b",
    "commandCenter.border": "#e7e7e799",
    "sash.hoverBorder": "#72a6f8",
    "statusBar.background": "#4287f5",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#72a6f8",
    "statusBarItem.remoteBackground": "#fcc2d9",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#4287f5",
    "titleBar.activeForeground": "#595959",
    "titleBar.inactiveBackground": "#4287f599",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#72a6f8",
    "activityBarTop.background": "#72a6f8",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#595959",
    "statusBar.debuggingBackground": "#4287f5",
    "statusBar.debuggingForeground": "#e7e7e7"
  },
  "peacock.color": "#4287f5"
}
